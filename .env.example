# Bungie API 凭据（必填）
# 申请地址：https://www.bungie.net/en/Application  重定向 URL 填 https://127.0.0.1:8902/bungie/callback
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=
BUNGIE_REDIRECT_URI=https://127.0.0.1:8902/bungie/callback

# 本地服务
HOST=127.0.0.1
PORT=8900
LOG_LEVEL=INFO

# 内置 DIM 顶部导航隐藏项(逗号分隔,可选)
#DIM_HIDE_NAV=vendors,records
