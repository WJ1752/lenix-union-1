# ===== 凭据（绝对不要提交）=====
.env
.env.local
bungie_token.json
*.pfx
# localhost 自签证书是 Bungie OAuth 回跳的必需件（Bungie 只认 https），
# 且不含机密（仅对 127.0.0.1 生效），所以随源码走；其它 pem/key 一律排除。
*.pem
*.key
!certs/localhost.pem
!certs/localhost-key.pem

# ===== 运行期状态（每个部署实例各自生成，不入库）=====
bot_config.json
user_bindings.json
*_cache.json
*cache.json
/weapon_usage_cache.json
/raidreport_ranks.json
# light.gg 解析失败的 HTML 调试转储（weapon_usage.py 生成）
/logs/usage_debug/

# ===== 虚拟环境 / 打包产物 =====
.venv/
venv/
__pycache__/
*.pyc
build/
dist/
dist_build/
*.exe
*.bak-*
*.zip

# ===== 大数据索引 / 第三方程序（由构建脚本生成或另行下载）=====
manifest_index/
icon_cache/
napcat_shell/
node_modules/

# ===== 日志 =====
*.log

# ===== 调试临时产物（根目录下的散落 html / json 转储）=====
/a.html
/dd.html
/g.html
/h.html
/ht.html
/pg.html
/pg2.html
/pt.html
/r.html
/rg.html
/t.html
/w.html
/wd.html
/wl.html
/wp.html
/pk.html
acts.json
sp.json
pgcr.json
shot_*.png
_scratch/

# ===== 测试截图 / 日志 / 页面转储（脚本本身保留）=====
_rtest/**/*.png
_rtest/**/*.log
_rtest/js/
_rtest/*.html
_rtest/_page.js

# ===== 临时/中间产物 =====
_*.png
ss_test.html
raid_images/
build_log*.txt
build_tmp/
dist_new/
dist_build/
build/

# ZCode 编辑预览临时目录（工具自动生成）
_preview/

# v2 皮肤改造的预览产物与工具
_rtest/v2/

# 官方 QQ 机器人凭证（AppSecret，绝不入库）
qq_official_creds.json

# 指令面板/菜单改动前的线上配置备份（可能含 group_openid）
qq_official_menu_backup.json

# 模糊搜索的玩家索引（运行期生成，含玩家名）
/seen_players.json
